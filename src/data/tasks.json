        {
          "text": "The session starts in a fresh worktree on its own branch, and dependencies are installed.",
          "act": [
            "loop",
            "env",
            "e_worktree",
            "e_branch",
            "e_deps",
            "e_image"
          ],
          "annotations": {
            "e_branch": "`fix/482-profile-null-email`",
            "e_worktree": "../wt-482",
            "e_deps": "`pnpm install`, from cache"
          },
          "fail": null
        },
        {
          "text": "The agent loop builds the first context: system prompt, tool definitions, `AGENTS.md`, memory notes, and the issue as the first message.",
          "act": [
            "loop",
            "lp_assemble",
            "context",
            "cx_system",
            "cx_tooldefs",
            "cx_instr",
            "cx_history",
            "memory",
            "task"
          ],
          "annotations": {
            "cx_instr": "`pnpm test`; no new dependencies",
            "memory": "Profile tests live in `src/profile/`"
          },
          "fail": null
        },
        {
          "text": "The model reads the context and replies with two tool calls. It runs nothing itself.",
          "act": [
            "context",
            "llm",
            "loop"
          ],
          "annotations": {
            "llm": "read `ProfileCard.tsx`; `grep email.domain`"
          },
          "fail": null
        },
        {
          "text": "Each call passes the permission gate. Reads and searches are allowed by rule, so they run at once.",
          "act": [
            "loop",
            "gate",
            "g_rules",
            "tools",
